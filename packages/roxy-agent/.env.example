# LLM Configuration
LLM_PROVIDER=siliconflow
LLM_MODEL=Pro/deepseek-ai/DeepSeek-V3.2
LLM_API_KEY=sk-...
LLM_BASE_URL=
MAX_TURNS=20
CONTEXT_MESSAGE_LIMIT=15
WORKER_CONTEXT_LIMIT=6
SYSTEM_LANGUAGE=zh-CN

# MCP Configuration
OPENAPI_SCRIPT_PATH=
OPENAPI_SCRIPT_SHA512=
ROXY_API_KEY=
ROXY_API_HOST=
PLAYWRIGHT_SCRIPT_PATH=
PLAYWRIGHT_SCRIPT_SHA512=

# Server Configuration
CHECKPOINT_DIR=./logs
ROXY_SERVER_PORT=3000
ROXY_USER_ID=
ROXY_WORKSPACE_ID=

# Context Management
MAX_MESSAGES_BEFORE_SUMMARY=20
KEEP_RECENT_MESSAGES=6
SIMPLE_SYNTHESIS_CONTEXT_LIMIT=10

# Optional Configuration
SILICONFLOW_THINKING_BUDGET=4096
SITE_URL=
SITE_NAME=
DEVELOPMENT=false
DEBUG=false
START_SCRIPT=
DOWNLOADS_DIR=
SKILLS_DIR=

# === IM Configuration ===
# Enable IM service (true/false)
ENABLE_IM=false

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Feishu (Lark) Configuration
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_USER_IDS=
FEISHU_ENVIRONMENT=feishu
FEISHU_DOMAIN=https://open.feishu.cn
