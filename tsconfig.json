{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node",
      "vite/client"
    ],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.ts",
    "**/*.d.ts",
    "./apps/electron/node_modules/electron/**/*.d.ts",
    "scripts/test.mjs",
    "apps/web/scripts/deploy.ts",
    "apps/web/scripts/deploy-web-dev.ts"
  ]
}
