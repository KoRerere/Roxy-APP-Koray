{
  "name": "roxy-agent-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Roxy AI Agent Runtime",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "coverage": "vitest run --coverage",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "catalog:",
    "js-yaml": "^4.1.0",
    "openai": "^7.4.0",
    "oxfmt": "^0.57.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "oxlint": "^1.71.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.7.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
