{
  "name": "web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:dev": "cross-env NODE_ENV=development vite build --mode development",
    "build:prod": "vite build",
    "preview": "vite build && vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "format": "prettier --write src/",
    "uploadSourceMaps": "npx @sentry/wizard@latest -i sourcemaps --saas",
    "genLanguage": "roxy-language-localization --work-dir=../ --target-dir=src/locales/langs --source-lang=zh-CN --lang-file-names=zh-CN,en,ru,fr,de,es,ko,tr,ja,pl"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@livechat/widget-core": "^1.3.3",
    "@livechat/widget-vue": "^1.3.3",
    "@mdi/font": "^7.4.47",
    "@primevue/themes": "^4.2.5",
    "@sentry/electron": "^5.9.0",
    "@sentry/vite-plugin": "^2.22.7",
    "@sentry/vue": "^8.47.0",
    "@vueuse/core": "^12.2.0",
    "axios": "^1.7.9",
    "core-js": "^3.39.0",
    "date-fns": "^4.1.0",
    "emoji-mart": "^5.6.0",
    "es-toolkit": "^1.31.0",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.0.0",
    "mitt": "^3.0.1",
    "mixpanel-browser": "^2.58.0",
    "pinia": "^2.3.0",
    "pinia-plugin-persistedstate": "4.2.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.5",
    "qs": "^6.13.1",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^11.0.1",
    "vue-router": "^4.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.2.5",
    "@roxy/backend-api": "workspace:*",
    "@roxy/electron-preload": "workspace:*",
    "@roxy/language-localization": "workspace:*",
    "@roxy/vite-plugins": "workspace:*",
    "@types/mixpanel-browser": "^2.50.2",
    "@types/node": "^22.9.0",
    "@types/qs": "^6.9.17",
    "@unocss/reset": "^0.65.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/tsconfig": "^0.7.0",
    "sass-embedded": "^1.83.0",
    "typescript": "~5.7.2",
    "unocss": "^0.65.3",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.6",
    "vite-plugin-vue-devtools": "^7.6.8",
    "vite-svg-loader": "^5.1.0",
    "vue-tsc": "^2.2.0"
  }
}