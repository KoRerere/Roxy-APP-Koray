{
  "compilerOptions": {
    "target": "esnext",
    "baseUrl": ".",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": [
      "node",
      "vite/client"
    ],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.ts",
    "**/*.d.ts",
    "./apps/electron/node_modules/electron/**/*.d.ts"
  ]
}
