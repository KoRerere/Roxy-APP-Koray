{
  "name": "@roxy/language-localization",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": "./dist/*",
    "./vite": {
      "import": "./dist/vite/index.js",
      "require": "./dist/vite/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:lib & vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
