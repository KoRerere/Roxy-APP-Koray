{
  "name": "roxybrowser",
  "version": "3.0.0",
  "private": false,
  "author": {
    "name": "kuajingzhiyan",
    "email": "1743369777@qq.com",
    "url": "https://github.com/buqiyuan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuajingzhiyan/roxy-browser"
  },
  "main": "dist-vite/index.cjs",
  "engines": {
    "node": ">=v16.13",
    "npm": ">=8.1"
  },
  "scripts": {
    "build-main": "webpack --config webpack.config.js",
    "test": "electron .",
    "build": "vite build && pnpm run build-main",
    "build:pkg": "npx tsx scripts/build.ts",
    "compile": "cross-env MODE=production npm run build && npm run build:pkg",
    "lint": "eslint . --ext js,ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "cross-env ELECTRON_RUN_AS_NODE=1 electron ../../scripts/update-electron-vendors.js"
  },
  "dependencies": {
    "@repo/node-typesafe-worker-messages": "workspace:*",
    "@roxy/backend-api": "workspace:*",
    "@roxy/electron-preload": "workspace:*",
    "adm-zip": "^0.5.15",
    "ali-oss": "^6.21.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.5",
    "compressing": "^1.10.1",
    "core-js": "^3.38.1",
    "date-fns": "^3.6.0",
    "electron-store": "^8.2.0",
    "electron-updater": "6.2.1",
    "es-toolkit": "^1.16.0",
    "express": "^4.19.2",
    "https-proxy-agent": "^7.0.5",
    "puppeteer-core": "21.3.8",
    "socks-proxy-agent": "^8.0.4",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@electron/notarize": "^2.4.0",
    "@types/ali-oss": "^6.16.11",
    "@types/archiver": "^6.0.2",
    "@types/express": "4.17.21",
    "@types/node": "^22.2.0",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "ts-loader": "^9.5.1",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "5.5.4",
    "vite": "5.4.2",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  }
}
