{
  "name": "roxybrowserdev",
  "type": "commonjs",
  "version": "3.0.0",
  "private": false,
  "author": {
    "name": "kuajingzhiyan",
    "email": "1743369777@qq.com",
    "url": "https://github.com/buqiyuan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuajingzhiyan/roxy-browser"
  },
  "main": "dist-vite/index.cjs",
  "engines": {
    "node": ">=v18.20.8",
    "npm": ">=10.1"
  },
  "scripts": {
    "bundle": "pnpx rimraf ./dist && webpack --config webpack.config.js",
    "build:dev": "vite build --mode development && pnpm bundle",
    "build:prod": "vite build && pnpm bundle",
    "pack:app": "cross-env NODE_OPTIONS=--max_old_space_size=8192 pnpx tsx scripts/build.ts",
    "pack:dev": "pnpm build:dev && dotenvx run -f .env.development -- pnpm pack:app",
    "pack:prod": "pnpm build:prod && dotenvx run -f .env.production -- pnpm pack:app",
    "pack:only:dev": "dotenvx run -f .env.development -- pnpm pack:app",
    "pack:only:prod": "dotenvx run -f .env.production -- pnpm pack:app",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "cross-env ELECTRON_RUN_AS_NODE=1 electron ../../scripts/update-electron-vendors.js"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@repo/node-typesafe-worker-messages": "workspace:*",
    "@roxy/backend-api": "workspace:*",
    "@roxy/electron-preload": "workspace:*",
    "@tomjs/unzip-crx": "^1.1.3",
    "@types/adm-zip": "^0.5.7",
    "@types/ali-oss": "^6.16.11",
    "@types/chrome-remote-interface": "^0.31.14",
    "@types/ejs": "^3.1.5",
    "@types/express": "5.0.3",
    "@types/node": "^22.14.0",
    "@vue/reactivity": "^3.5.16",
    "adm-zip": "^0.5.16",
    "ali-oss": "^6.23.0",
    "await-to-js": "^3.0.0",
    "axios": "catalog:",
    "body-parser": "^2.2.0",
    "chrome-remote-interface": "^0.33.3",
    "compare-versions": "^6.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "ejs": "^3.1.10",
    "electron": "35.5.1",
    "electron-builder": "25.1.8",
    "electron-log": "^5.4.0",
    "electron-updater": "6.6.5",
    "es-toolkit": "^1.38.0",
    "express": "^5.1.0",
    "font-list": "^1.5.1",
    "http-proxy-agent": "^7.0.2",
    "http-proxy-middleware": "^3.0.5",
    "https-proxy-agent": "^7.0.6",
    "intl-messageformat": "^10.7.16",
    "node-2fa": "^2.0.3",
    "node-machine-id": "^1.1.12",
    "portfinder": "^1.0.37",
    "puppeteer-core": "21.3.8",
    "socks-proxy-agent": "^8.0.5",
    "systeminformation": "^5.27.1",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  }
}