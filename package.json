{
  "name": "electron-vite-monorepo",
  "version": "0.0.0",
  "private": false,
  "packageManager": "pnpm@9.6.0",
  "author": {
    "name": "buqiyuan",
    "email": "1743369777@qq.com",
    "url": "https://github.com/buqiyuan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buqiyuan/electron-vite-monorepo.git"
  },
  "engines": {
    "pnpm": ">=9.0.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/watch.ts",
    "dev:pkg": "pnpm -F \"./packages/**\" dev",
    "build:pkg": "pnpm -F \"./packages/**\" build",
    "build": "turbo run build && pnpm run compile",
    "dev:p": "turbo run dev --parallel",
    "compile": "turbo run compile",
    "pack:pkg": "pnpm -F electron-main run build:pkg",
    "postinstall": "npm run build:pkg",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.25.1",
    "@types/node": "^22.2.0",
    "@unocss/eslint-plugin": "^0.62.1",
    "cross-env": "^7.0.3",
    "eslint": "9.9.0",
    "eslint-plugin-format": "^0.1.2",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "simple-git-hooks": "^2.11.1",
    "tsx": "^4.17.0",
    "turbo": "^2.0.13",
    "vite": "^5.4.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "*"
      }
    },
    "overrides": {}
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
