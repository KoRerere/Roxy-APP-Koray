{
  "name": "@roxy/electron-preload",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./main": {
      "types": "./src/ipcMain.ts",
      "development": "./src/ipcMain.ts",
      "default": "./dist/ipcMain.mjs"
    },
    "./dist/*": "./dist/*"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=v16.13",
    "npm": ">=8.1"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "electron": "^40.6.1"
  },
  "devDependencies": {
    "@roxy/backend-api": "workspace:*",
    "electron-log": "^5.4.3",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"

  }
}
