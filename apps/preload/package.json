{
  "name": "@roxy/electron-preload",
  "type": "commonjs",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.cjs"
    },
    "./main": {
      "types": "./src/ipcMain.ts",
      "development": "./src/ipcMain.ts",
      "default": "./dist/ipcMain.cjs"
    },
    "./dist/*": "./dist/*"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=v16.13",
    "npm": ">=8.1"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "electron": "^22.3.27"
  },
  "devDependencies": {
    "@roxy/backend-api": "workspace:*",
    "vite": "^6.0.6",
    "vite-plugin-dts": "^4.4.0"
  }
}