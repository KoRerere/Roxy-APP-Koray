{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoxyChrome",
  "mainBinaryName": "RoxyChrome",
  "version": "1.0.10",
  "identifier": "com.roxybrowser.browser.launcher",
  "build": {
    "frontendDist": "empty-dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "RoxyChrome",
        "width": 480,
        "height": 320,
        "visible": false,
        "resizable": false,
        "minWidth": 480,
        "maxWidth": 480,
        "minHeight": 320,
        "maxHeight": 320,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "signCommand": "signtool sign /fd sha256 /tr http://timestamp.digicert.com /td sha256 /f \"../../electron/pfx/linkv.pfx\" /p \"0000\" \"%1\""
    },
    "targets": "all",
    "icon": [
      "icons/windows/32x32.png",
      "icons/windows/128x128.png",
      "icons/windows/128x128@2x.png",
      "icons/windows/icon.png",
      "icons/macos/icon.icns",
      "icons/windows/icon.ico"
    ]
  }
}
