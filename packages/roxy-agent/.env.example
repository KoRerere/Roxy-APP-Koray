# 大模型代理商，可选 siliconflow, openrouter
LLM_PROVIDER=siliconflow
# 大模型
LLM_MODEL=Pro/deepseek-ai/DeepSeek-V3.2
# apikey
LLM_API_KEY=sk-wxnwfldyelnxcdcanjotibnlxaunqlqwipxxvijcjuaintjz
# baseurl
LLM_BASE_URL=

# 
SILICONFLOW_THINKING_BUDGET=4096

# function calling 最多循环次数
MAX_TURNS=20
# 对话上下文最多的条数
CONTEXT_MESSAGE_LIMIT=15
# worker 进程最多可以同时启动多少个
WORKER_CONTEXT_LIMIT=0
# 系统语言（同步前端语言）
SYSTEM_LANGUAGE=zh-CN
# 上下文压缩阈值
MAX_MESSAGES_BEFORE_SUMMARY=6
#
KEEP_RECENT_MESSAGES=6
# 
SIMPLE_SYNTHESIS_CONTEXT_LIMIT=10

# openapi mcp 工具脚本
OPENAPI_SCRIPT_PATH=./openapi-mcp/index.mjs

# roxybrowser 开放key
ROXY_API_KEY=e9e04546f54bf2e9653fd828d3837bfd
# roxybrowser 请求地址
ROXY_API_HOST=http://127.0.0.1:50000

# playwright 工具脚本
PLAYWRIGHT_SCRIPT_PATH=./playwright-mcp/index.mjs

# AI 对话存储本地路径
CHECKPOINT_DIR=./logs

# 提供对话管理/流式输出的服务端口
ROXY_SERVER_PORT=3000

# 用户ID
ROXY_USER_ID=28062
# workspaceId
ROXY_WORKSPACE_ID=10378


# OpenRouter headers (optional but recommended)
SITE_URL=http://localhost:3000
SITE_NAME=Orchestrator