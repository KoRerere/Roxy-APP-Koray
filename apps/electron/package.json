{
  "name": "roxybrowserdev",
  "type": "module",
  "version": "3.0.0",
  "private": false,
  "author": {
    "name": "roxy-browser",
    "email": "support@RoxyBrowser.com",
    "url": "https://github.com/roxybrowser"
  },
  "license": "MIT",
  "homepage": "https://roxybrowser.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/roxybrowser/roxy-browser"
  },
  "main": "dist-vite/index.mjs",
  "engines": {
    "node": ">=v22.16.0",
    "npm": ">=10.1"
  },
  "scripts": {
    "bundle": "pnpx rimraf ./dist && webpack --config webpack.config.cjs",
    "build:dev": "vite build --mode development && pnpm bundle",
    "build:prod": "vite build && pnpm bundle",
    "pack:app": "cross-env NODE_OPTIONS=--max_old_space_size=8192 pnpx tsx scripts/build.mts",
    "pack:dev": "dotenvx run -f .env.development -- pnpm build:dev && pnpm pack:dev:noBuild",
    "pack:prod": "dotenvx run -f .env.production -- pnpm build:prod && pnpm pack:prod:noBuild",
    "pack:dev:noBuild": "dotenvx run -f .env.development -- pnpm pack:app",
    "pack:prod:noBuild": "dotenvx run -f .env.production -- pnpm pack:app",
    "pack:dev:noSign": "cross-env SKIP_CODE_SIGNING=true dotenvx run -f .env.development -- pnpm build:dev && pnpm pack:dev:noSign:noBuild",
    "pack:dev:noSign:noBuild": "cross-env SKIP_CODE_SIGNING=true dotenvx run -f .env.development -- pnpm pack:app",
    "pack:prod:noSign": "cross-env SKIP_CODE_SIGNING=true dotenvx run -f .env.production -- pnpm build:prod && pnpm pack:prod:noSign:noBuild",
    "pack:prod:noSign:noBuild": "cross-env SKIP_CODE_SIGNING=true dotenvx run -f .env.production -- pnpm pack:app",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "cross-env ELECTRON_RUN_AS_NODE=1 electron ../../scripts/update-electron-vendors.js",
    "debug:dist": "electron . --experimental-network-inspection",
    "notarytool": "pnpx tsx scripts/notarytool.mts",
    "pack:app:mac:dev": "pnpm run pack:dev && pnpm run notarytool"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@repo/node-typesafe-worker-messages": "workspace:*",
    "@roxy/backend-api": "workspace:*",
    "@roxy/electron-preload": "workspace:*",
    "@roxy/webpack-plugins": "workspace:*",
    "@sentry/electron": "^7.5.0",
    "@sentry/webpack-plugin": "^4.6.1",
    "@tomjs/unzip-crx": "^1.1.3",
    "@types/adm-zip": "^0.5.7",
    "@types/ali-oss": "^6.16.13",
    "@types/chrome-remote-interface": "^0.33.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "5.0.6",
    "@types/node": "^22.14.0",
    "@types/node-geocoder": "^4.2.6",
    "@vue/reactivity": "^3.5.25",
    "adm-zip": "^0.5.16",
    "ali-oss": "^6.23.0",
    "await-to-js": "^3.0.0",
    "axios": "catalog:",
    "body-parser": "^2.2.1",
    "chrome-remote-interface": "^0.33.3",
    "compare-versions": "^6.1.1",
    "date-fns": "^4.1.0",
    "ejs": "^3.1.10",
    "electron": "38.7.2",
    "electron-builder": "26.3.6",
    "electron-log": "^5.4.3",
    "electron-updater": "6.7.3",
    "es-toolkit": "^1.43.0",
    "express": "^5.2.1",
    "font-list": "^2.0.1",
    "geo-tz": "^8.1.4",
    "get-folder-size": "^5.0.0",
    "http-proxy-agent": "^7.0.2",
    "http-proxy-middleware": "^3.0.5",
    "https-proxy-agent": "^7.0.6",
    "intl-messageformat": "^11.0.2",
    "node-2fa": "^2.0.3",
    "node-geocoder": "^4.4.1",
    "node-machine-id": "^1.1.12",
    "portfinder": "^1.0.38",
    "puppeteer-core": "24.10.1",
    "socks-proxy-agent": "^8.0.5",
    "systeminformation": "^5.27.14",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.4",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "webpack": "^5.104.0",
    "webpack-cli": "^6.0.1"
  }
}
