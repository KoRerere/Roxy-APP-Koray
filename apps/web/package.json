    "@primevue/themes": "^4.3.4",
    "@types/qrcode": "^1.5.5",
    "@vueuse/components": "^13.2.0",
    "@vueuse/core": "^13.2.0",
    "axios": "catalog:",
    "canvas-confetti": "^1.9.3",
    "currency.js": "^2.0.4",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
