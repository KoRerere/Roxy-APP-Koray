{
  "name": "@roxy/openapi",
  "type": "commonjs",
  "version": "1.0.4",
  "description": "MCP server for RoxyBrowser automation - manage browser instances and get CDP endpoints",
  "author": "RoxyBrowser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roxybrowserlabs/roxybrowser-mcp-server"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "roxybrowser",
    "browser-automation",
    "cdp",
    "chrome-devtools-protocol"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bundle": "pnpx rimraf ./dist && webpack --config webpack.config.cjs",
    "build": "vite build && pnpm bundle",
    "start": "node dist/index.js",
    "dev": "vite build --watch",
    "clean": "npx rimraf dist",
    "publish:release": "npm run clean && npm version patch --no-git-tag-version && npm run build && npm publish",
    "publish:beta": "npm version prerelease --preid=beta --no-git-tag-version && npm run build && npm publish --tag beta"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@roxybrowser/openapi": "1.0.10",
    "terser-webpack-plugin": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "webpack": "catalog:",
    "webpack-cli": "catalog:"
  }
}
