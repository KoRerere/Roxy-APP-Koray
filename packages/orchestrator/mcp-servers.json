      "command": "node",
      "args": [
        "../roxybrowser-playwright-mcp/dist/index.mjs"
      ],
      "env": {
        "PLAYWRIGHT_MCP_SNAPSHOT_MODE": "optimized",
        "PLAYWRIGHT_MCP_ROXY_MODE": "true"
      }
    }
  }
}
