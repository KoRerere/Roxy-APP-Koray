{
  "name": "web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:dev": "dotenvx run -f .env.development -- vite build --mode development",
    "build:prod": "dotenvx run -f .env.production -- vite build",
    "preview": "vite build && vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "format": "prettier --write src/",
    "uploadSourceMaps": "npx @sentry/wizard@latest -i sourcemaps --saas",
    "genLanguage": "roxy-language-localization --work-dir=../ --target-dir=src/locales/langs --source-lang=zh-CN --lang-file-names=zh-CN,en,ru"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@livechat/widget-core": "^1.3.4",
    "@livechat/widget-vue": "^1.3.4",
    "@number-flow/vue": "^0.4.8",
    "@primeuix/themes": "^1.2.1",
    "@primevue/forms": "^4.3.6",
    "@sentry/electron": "^7.1.1",
    "@sentry/vue": "^10.18.0",
    "@stripe/stripe-js": "^7.8.0",
    "@types/qrcode": "^1.5.5",
    "@vueuse/components": "^13.9.0",
    "@vueuse/core": "^13.9.0",
    "axios": "catalog:",
    "canvas-confetti": "^1.9.3",
    "currency.js": "^2.0.4",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dom-align": "^1.12.4",
    "driver.js": "^1.3.6",
    "emoji-mart": "^5.6.0",
    "es-toolkit": "^1.39.3",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.1.0",
    "mitt": "^3.0.1",
    "mixpanel-browser": "^2.71.0",
    "motion-v": "^1.3.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "4.5.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.6",
    "qrcode": "^1.5.4",
    "qs": "^6.14.0",
    "simplex-noise": "^4.0.3",
    "vue": "^3.5.22",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.3.6",
    "@roxy/backend-api": "workspace:*",
    "@roxy/electron-preload": "workspace:*",
    "@roxy/language-localization": "workspace:*",
    "@roxy/vite-plugins": "workspace:*",
    "@sentry/vite-plugin": "^4.4.0",
    "@sentry/wizard": "^6.6.0",
    "@types/mixpanel-browser": "^2.66.0",
    "@types/node": "^22.13.9",
    "@types/qs": "^6.14.0",
    "@unocss/reset": "^66.5.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vue/tsconfig": "^0.8.1",
    "sass-embedded": "^1.93.2",
    "typescript": "catalog:",
    "unocss": "^66.5.4",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vite-svg-loader": "^5.1.0",
    "vue-tsc": "^3.1.1"
