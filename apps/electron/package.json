{
  "name": "roxybrowser",
  "type": "commonjs",
  "version": "3.0.0",
  "private": false,
  "author": {
    "name": "kuajingzhiyan",
    "email": "1743369777@qq.com",
    "url": "https://github.com/buqiyuan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuajingzhiyan/roxy-browser"
  },
  "main": "dist-vite/index.cjs",
  "engines": {
    "node": ">=v16.13",
    "npm": ">=8.1"
  },
  "scripts": {
    "bundle": "npx rimraf ./dist && webpack --config webpack.config.js",
    "build:dev": "vite build --mode development && pnpm bundle",
    "build:prod": "vite build && pnpm bundle",
    "pack:app": "npx tsx scripts/build.ts",
    "pack:dev": "pnpm build:dev && dotenvx run -f .env.development -- pnpm pack:app",
    "pack:prod": "pnpm build:prod && dotenvx run -f .env.production -- pnpm pack:app",
    "pack:only:dev": "dotenvx run -f .env.development -- pnpm pack:app",
    "pack:only:prod": "dotenvx run -f .env.production -- pnpm pack:app",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "cross-env ELECTRON_RUN_AS_NODE=1 electron ../../scripts/update-electron-vendors.js"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@repo/node-typesafe-worker-messages": "workspace:*",
    "@roxy/backend-api": "workspace:*",
    "@roxy/electron-preload": "workspace:*",
    "@sentry/electron": "^5.7.0",
    "@tomjs/unzip-crx": "^1.1.3",
    "@types/adm-zip": "^0.5.6",
    "@types/ali-oss": "^6.16.11",
    "@types/express": "5.0.0",
    "@types/node": "^22.2.0",
    "adm-zip": "^0.5.16",
    "ali-oss": "^6.21.0",
    "await-to-js": "^3.0.0",
    "axios": "^1.7.8",
    "body-parser": "^1.20.3",
    "compare-versions": "^6.1.1",
    "core-js": "^3.39.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "electron": "22.3.27",
    "electron-builder": "25.1.8",
    "electron-log": "^5.2.3",
    "electron-updater": "6.3.9",
    "es-toolkit": "^1.27.0",
    "express": "^5.0.1",
    "font-list": "^1.5.1",
    "http-proxy-middleware": "^3.0.3",
    "https-proxy-agent": "^7.0.5",
    "iconv-lite": "^0.6.3",
    "intl-messageformat": "^10.7.7",
    "macaddress": "^0.5.3",
    "mitt": "^3.0.1",
    "node-2fa": "^2.0.3",
    "portfinder": "^1.0.32",
    "puppeteer-core": "21.3.8",
    "socks-proxy-agent": "^8.0.4",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "5.7.2",
    "vite": "^6.0.1",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  }
}