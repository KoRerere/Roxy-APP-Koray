  "main": "dist/index.cjs",
  "engines": {
    "node": ">=v16.13",
    "npm": ">=8.1"
  },
  "scripts": {
    "build": "vite build",
    "build:pkg": "npx tsx scripts/build.ts",
    "compile": "cross-env MODE=production npm run build && npm run build:pkg",
    "lint": "eslint . --ext js,ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "cross-env ELECTRON_RUN_AS_NODE=1 electron ../../scripts/update-electron-vendors.js"
  },
  "dependencies": {
    "@repo/node-typesafe-worker-messages": "workspace:*",
    "@roxy/backend-api": "workspace:*",
    "@roxy/electron-preload": "workspace:*",
    "ali-oss": "^6.21.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.4",
    "compressing": "^1.10.1",
    "core-js": "^3.38.0",
    "date-fns": "^3.6.0",
    "electron-store": "^8.2.0",
    "electron-updater": "6.2.1",
    "puppeteer-core": "21.3.8",
    "unzipper": "^0.12.3",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "yauzl": "^3.1.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.4.0",
    "@types/ali-oss": "^6.16.11",
    "@types/archiver": "^6.0.2",
    "@types/node": "^22.2.0",
    "@types/unzipper": "^0.10.10",
    "@types/yauzl": "^2.10.3",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "typescript": "5.5.4",
    "vite": "5.4.1"
  }
