{
  "name": "electron-vite-monorepo",
  "version": "0.0.0",
  "private": false,
  "packageManager": "pnpm@9.6.0",
  "author": {
    "name": "buqiyuan",
    "email": "1743369777@qq.com",
    "url": "https://github.com/buqiyuan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buqiyuan/electron-vite-monorepo.git"
  },
  "engines": {
    "pnpm": ">=9.0.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/watch.ts",
    "dev:watch": "tsx scripts/watch.ts --watch",
    "dev:pkg": "pnpm -F \"./packages/**\" dev",
    "build:pkg": "pnpm -F \"./packages/**\" build",
    "build": "turbo run build",
    "dev:p": "turbo run dev --parallel",
    "compile": "pnpm build && turbo run compile",
    "pack:dev": "pnpm run build && pnpm -F web run build:dev && pnpm -F roxybrowser run pack:dev",
    "pack:prod": "pnpm run build && pnpm -F web run build:prod && pnpm -F roxybrowser run pack:prod",
    "publish:app:dev": "pnpm run pack:dev && cross-env NODE_ENV=development tsx scripts/publish.ts",
    "publish:app:prod": "pnpm run pack:prod && cross-env NODE_ENV=production tsx scripts/publish.ts",
    "publish:web:dev": "pnpm -F web run build:dev && cross-env NODE_ENV=development npx tsx ./scripts/upload-web-source.ts",
    "publish:web:prod": "pnpm -F web run build:prod && cross-env NODE_ENV=production npx tsx ./scripts/upload-web-source.ts",
    "publish:web:win:prod": "pnpm -F web run build:prod && cross-env NODE_ENV=production PLATFORM=win npx tsx ./scripts/upload-web-source.ts",
    "openapi": "pnpm -F @roxy/backend-api run openapi",
    "genLanguage": "pnpm -F web run genLanguage",
    "postinstall": "npm run build:pkg",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "clean:cache": "npx rimraf node_modules/.cache/ && npx rimraf node_modules/.vite",
    "clean:lib": "npx rimraf --glob node_modules **/node_modules",
    "reinstall": "npx rimraf pnpm-lock.yaml && pnpm clean:lib",
    "test": "cross-env NODE_ENV=development tsx scripts/test.ts"
  },
  "optionalDependencies": {
    "minidump": "^0.26.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.11.2",
    "@dotenvx/dotenvx": "^1.26.0",
    "@types/adm-zip": "^0.5.7",
    "@types/ali-oss": "^6.16.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@unocss/eslint-plugin": "^0.65.0",
    "adm-zip": "^0.5.16",
    "ali-oss": "^6.21.0",
    "cross-env": "^7.0.3",
    "eslint": "9.16.0",
    "eslint-plugin-format": "^0.1.3",
    "js-yaml": "^4.1.0",
    "lint-staged": "^15.2.10",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.11.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "vite": "^6.0.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {}
    },
    "overrides": {}
  },
  "simple-git-hooks": {
    "post-checkout": "",
    "pre-commit": "pnpm lint-staged",
    "post-merge": "pnpm install"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
