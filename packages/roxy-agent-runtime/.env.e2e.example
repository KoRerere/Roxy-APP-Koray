# E2E test environment — copy to .env.e2e and fill in your keys.
# .env.e2e is gitignored; this example file is tracked.

# ─── DeepSeek (Anthropic-native API) ─────────────────────────────────────────
DEEPSEEK_API_KEY=sk-a0331c9ec88f40828f2f3c76d18c4d88

# Base URL for DeepSeek's Anthropic-compatible endpoint.
# Adjust if DeepSeek changes their path (e.g. /anthropic/v1).
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# Model ID as reported by DeepSeek's API.
DEEPSEEK_MODEL=deepseek-v4-flash

# Auth style — DeepSeek's Anthropic endpoint uses Bearer, not x-api-key.
# Set in code (smoke.e2e.ts), documented here for reference.
