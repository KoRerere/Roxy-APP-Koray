    "@roxy/backend-api": "workspace:*",
    "@roxy/shared": "workspace:*",
    "ali-oss": "^6.23.0",
    "axios": "^1.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compare-versions": "^6.1.1",
    "dockerode": "^4.0.10",
    "es-toolkit": "^1.45.1",
    "font-list": "^2.0.2",
