# ========================================
# LLM Provider Configuration
# ========================================
# Supported providers: openrouter, siliconflow
# Default: openrouter (for backward compatibility)
LLM_PROVIDER=openrouter

# ========================================
# OpenRouter Configuration
# ========================================
OPENROUTER_API_KEY=your_api_key_here

# Default model (with :thinking suffix for thinking mode support)
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet:thinking

# OpenRouter headers (optional but recommended)
SITE_URL=http://localhost:3000
SITE_NAME=Orchestrator

# ========================================
# SiliconFlow Configuration
# ========================================
# API Key (required when LLM_PROVIDER=siliconflow)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Model name (default: deepseek-ai/DeepSeek-V3)
# Popular models: deepseek-ai/DeepSeek-V3, Qwen/Qwen2.5-72B-Instruct, etc.
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# Thinking budget: token limit for reasoning (128-32768, default: 4096)
# Higher values allow more detailed reasoning but consume more tokens
SILICONFLOW_THINKING_BUDGET=4096

# ========================================
# General Settings
# ========================================

# Debug mode (set to true to enable verbose logging)
DEBUG=false

# Maximum turns for tool calling loop (default: 20)
# Set to higher value for complex multi-step operations
# Warning: Very high values may consume many API tokens
MAX_TURNS=20

# ========================================
# Context Settings
# ========================================
# Number of recent messages to include in orchestrator planning and synthesis (default: 15)
# Planning and Synthesis stages will use the last N messages for better context understanding
CONTEXT_MESSAGE_LIMIT=15

# Number of recent messages to pass to workers as context (default: 10)
# Workers execute specific tasks and may need less context than planning/synthesis
# Lower values save tokens while maintaining task execution quality
WORKER_CONTEXT_LIMIT=10

# ========================================
# Prompts Language Configuration
# ========================================
# Supported values: en (English), zh (Chinese)
# Default: en
PROMPTS_LANGUAGE=en
