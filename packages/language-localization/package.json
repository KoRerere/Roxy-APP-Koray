    "stub:lib": "vite build --config vite.lib.config.ts --watch"
  },
  "dependencies": {
    "@roxy/puppeteer-google-translate": "workspace:*",
    "body-parser": "^1.20.3",
    "es-toolkit": "^1.25.2",
