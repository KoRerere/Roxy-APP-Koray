{
  "name": "@roxy/diskspace-native",
  "type": "module",
  "version": "1.0.0",
  "description": "Template project for writing node package with napi-rs",
  "license": "n",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/napi-rs/package-template.git"
  },
  "browser": "browser.js",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api"
  ],
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./diskspace-native.win32-x64-msvc.node": "./diskspace-native.win32-x64-msvc.node"
  },
  "main": "index.js",
  "files": [
    "diskspace-native.win32-x64-msvc.node",
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "diskspace-native",
    "targets": [
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 12.22.0 < 13 || >= 14.17.0 < 15 || >= 15.12.0 < 16 || >= 16.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build:native": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "preversion": "napi build --platform && git add .",
    "version": "napi version"
  },
  "devDependencies": {
    "@emnapi/core": "^1.8.1",
    "@emnapi/runtime": "^1.8.1",
    "@napi-rs/cli": "^3.5.1",
    "@taplo/cli": "^0.7.0",
    "chalk": "^5.6.2",
    "typescript": "catalog:"
  }
}
