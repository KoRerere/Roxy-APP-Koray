# 本地打包（macOS）签名/公证环境变量（允许提交到 git）
#
# 官方文档（字段名/说明）：
# https://v2.tauri.app/distribute/sign/macos/
#
# 使用方式：
#   cd apps/tauri
#   pnpm build:mac
#
# 提示：
# - APPLE_SIGNING_IDENTITY 可覆盖 tauri.conf.json 的 bundle.macOS.signingIdentity
# - 公证（notarize）二选一：Apple ID 方式 或 App Store Connect API 方式

########################################
# 1) 签名
########################################
# 通过 `security find-identity -v -p codesigning` 查到的 identity 字符串
# 例：Developer ID Application: XXX (GLM223L5MF)
# 参考 Electron 配置（apps/electron/scripts/build.mts）补全为 Tauri 文档建议的完整 identity 格式：
# 注意：最终以你本机 `security find-identity -v -p codesigning` 输出为准（Tauri 文档也要求用它来确认）。
APPLE_SIGNING_IDENTITY=Developer ID Application: LINKV TECH PTE. LTD. (GLM223L5MF)

########################################
# 2) 公证（Notarization）二选一
########################################

# 2.1 Apple ID 方式
APPLE_ID=1019994756@qq.com
# app-specific password（不是你的 Apple ID 登录密码）
APPLE_PASSWORD=tcfp-quxc-dqqi-wnac
APPLE_TEAM_ID=GLM223L5MF

# 2.2 App Store Connect API 方式（可选）
# APPLE_API_ISSUER=
# APPLE_API_KEY=
# APPLE_API_KEY_PATH=

########################################
# 3) CI 才常用：证书注入（本地一般不需要）
########################################
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=


