{
  "name": "electron-vite-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": false,
  "packageManager": "pnpm@10.18.3",
  "author": {
    "name": "buqiyuan",
    "email": "1743369777@qq.com",
    "url": "https://github.com/buqiyuan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buqiyuan/electron-vite-monorepo.git"
  },
  "engines": {
    "pnpm": ">=10.18.3",
    "node": ">=22.20.0"
  },
  "volta": {
    "node": "22.20.0",
    "pnpm": "10.18.3"
  },
  "scripts": {
    "dev": "tsx scripts/watch.ts --watch",
    "start": "tsx scripts/watch.ts",
    "dev:pkg": "pnpm -F \"./packages/**\" dev",
    "build:pkg": "pnpm -F \"./packages/**\" build",
    "build": "turbo run build",
    "dev:p": "turbo run dev --parallel",
    "compile": "pnpm build && turbo run compile",
    "pack:dev": "pnpm run build && pnpm -F web run build:dev && pnpm -F roxybrowserdev run pack:dev",
    "pack:prod": "pnpm run build && pnpm -F web run build:prod && pnpm -F roxybrowserdev run pack:prod",
    "pack:dev:only": "pnpm -F roxybrowserdev run pack:dev",
    "pack:prod:only": "pnpm -F roxybrowserdev run pack:prod",
    "notarize:app": "pnpm -F roxybrowserdev run notarytool",
    "publish:app:dev": "pnpm run pack:dev && cross-env NODE_ENV=development tsx scripts/publish.ts",
    "publish:app:prod": "pnpm run pack:prod && cross-env NODE_ENV=production tsx scripts/publish.ts",
    "publish:app:dev:only": "cross-env NODE_ENV=development tsx scripts/publish.ts",
    "publish:app:prod:only": "cross-env NODE_ENV=production tsx scripts/publish.ts",
    "publish:web:dev": "pnpm -F web run build:dev && cross-env NODE_ENV=development pnpx tsx ./scripts/upload-web-source.ts",
    "publish:web:prod": "pnpm -F web run build:prod && cross-env NODE_ENV=production pnpx tsx ./scripts/upload-web-source.ts",
    "publish:web:win:prod": "pnpm -F web run build:prod && cross-env NODE_ENV=production PLATFORM=win pnpx tsx ./scripts/upload-web-source.ts",
    "publish:app:dev:noPack": "cross-env NODE_ENV=development tsx scripts/publish.ts",
    "publish:app:prod:noPack": "cross-env NODE_ENV=production tsx scripts/publish.ts",
    "publish:app:mac:dev": "pnpm -F roxybrowserdev run pack:app:mac:dev && pnpm run publish:app:dev:noPack",
    "openapi": "pnpm -F @roxy/backend-api run openapi",
    "genLanguage": "pnpm -F web run genLanguage",
    "postinstall": "npm run build:pkg && pnpm rebuild:electron && npm run install:electron",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "clean:cache": "pnpx rimraf node_modules/.cache/ && pnpx rimraf node_modules/.vite",
    "clean:lib": "pnpx rimraf --glob node_modules **/node_modules",
    "reinstall": "pnpx rimraf pnpm-lock.yaml && pnpm clean:lib",
    "test": "cross-env NODE_ENV=development tsx scripts/test.ts",
    "install:electron": "cd apps/electron && cross-env ELECTRON_GET_USE_PROXY=true node node_modules/electron/install.js",
    "reset:main": "node scripts/confirm-reset.js",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3"
  },
  "optionalDependencies": {
    "minidump": "^0.26.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@dotenvx/dotenvx": "^1.44.2",
    "@electron/rebuild": "^3.7.2",
    "@modelcontextprotocol/sdk": "1.25.1",
    "@types/adm-zip": "^0.5.7",
    "@types/ali-oss": "^6.23.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@unocss/eslint-plugin": "^66.5.12",
    "adm-zip": "^0.5.16",
    "ali-oss": "^6.23.0",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.6.0",
    "bindings": "^1.5.0",
    "cross-env": "^10.1.0",
    "eslint": "9.39.2",
    "eslint-plugin-format": "^1.3.1",
    "file-uri-to-path": "catalog:",
    "js-yaml": "^4.1.1",
    "lint-staged": "^16.2.7",
    "rimraf": "^6.1.2",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "overrides": {
    "@electron/rebuild>node-gyp": "^12.1.0"
  }
}
