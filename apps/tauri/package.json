{
  "name": "tauri",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "volta": {
    "node": "22.20.0",
    "pnpm": "10.18.3"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite dev",
    "preview": "vite preview",
    "build:web": "vite build --mode production",
    "build:mac:adhoc": "pnpm run pack:app:dev -- --adhoc --skip-notarize",
    "build:mac:sign-only": "pnpm run pack:app:dev -- --skip-notarize",
    "pack:app:dev": "pnpm run build:web && node --env-file=.env.development scripts/tauri-build.ts",
    "pack:app:prod": "pnpm run build:web && node --env-file=.env.production scripts/tauri-build.ts",
    "publish:app:dev": "pnpm run pack:app:dev && node --env-file=.env.development scripts/publish.ts",
    "publish:app:prod": "pnpm run pack:app:prod && node --env-file=.env.production scripts/publish.ts",
    "publish:app:dev:only": "node --env-file=.env.development scripts/publish.ts",
    "publish:app:prod:only": "node --env-file=.env.production scripts/publish.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "@vitejs/plugin-vue": "^6.0.3",
    "typescript": "~5.9.3",
    "vite": "catalog:",
    "vue-tsc": "^3.2.1"
  }
}
