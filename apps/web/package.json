{
  "name": "web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run -f .env.development -- vite dev",
    "build:dev": "dotenvx run -f .env.development -- vite build --mode development",
    "build:prod": "dotenvx run -f .env.production -- vite build",
    "preview": "vite build && vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "format": "prettier --write src/",
    "uploadSourceMaps": "npx @sentry/wizard@latest -i sourcemaps --saas",
    "genLanguage": "roxy-language-localization --work-dir=../ --target-dir=src/locales/langs --source-lang=zh-CN --lang-file-names=zh-CN,en,ru"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/state": "^6.5.3",
    "@codemirror/view": "^6.38.8",
    "@emoji-mart/data": "^1.2.1",
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@fireworks-js/vue": "^2.10.8",
    "@lezer/highlight": "^1.2.3",
    "@livechat/widget-core": "^1.4.0",
    "@livechat/widget-vue": "^1.4.0",
    "@number-flow/vue": "^0.4.8",
    "@primeuix/themes": "^1.2.1",
    "@primevue/forms": "^4.5.4",
    "@roxy/shared": "workspace:*",
    "@sentry/vue": "^10.40.0",
    "@stripe/stripe-js": "^8.8.0",
    "@types/qrcode": "^1.5.5",
    "@vueuse/components": "^13.9.0",
    "@vueuse/core": "^13.9.0",
    "axios": "catalog:",
    "canvas-confetti": "^1.9.4",
    "currency.js": "^2.0.4",
    "custom-protocol-check": "^1.4.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dom-align": "^1.12.4",
    "dompurify": "catalog:",
    "driver.js": "^1.3.6",
    "electron-log": "^5.4.3",
    "emoji-mart": "^5.6.0",
    "es-toolkit": "^1.43.0",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.1.0",
    "highlight.js": "catalog:",
    "marked": "catalog:",
    "mitt": "^3.0.1",
    "mixpanel-browser": "^2.75.0",
    "motion-v": "^1.3.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "4.7.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "qrcode": "^1.5.4",
    "qs": "^6.14.1",
    "simplex-noise": "^4.0.3",
    "vue": "3.5.25",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.5.4",
    "@roxy/backend-api": "workspace:*",
    "@roxy/electron-preload": "workspace:*",
    "@roxy/language-localization": "workspace:*",
    "@roxy/vite-plugins": "workspace:*",
    "@sentry/vite-plugin": "^5.1.0",
    "@sentry/wizard": "^6.11.0",
    "@types/node": "^22.13.9",
    "@types/qs": "^6.14.0",
    "@unocss/reset": "^66.6.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vue/tsconfig": "^0.8.1",
    "sass-embedded": "^1.97.3",
    "typescript": "catalog:",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "catalog:",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vite-svg-loader": "^5.1.0",
    "vue-tsc": "^3.2.5"
  }
}
