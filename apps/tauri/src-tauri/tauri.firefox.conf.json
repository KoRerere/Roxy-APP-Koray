{
  "productName": "RoxyFirefox",
  "mainBinaryName": "RoxyFirefox",
  "identifier": "com.roxybrowser.browser.launcher.firefox",
  "build": {
    "frontendDist": "empty-dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "RoxyFirefox",
        "width": 480,
        "height": 320,
        "visible": false,
        "resizable": false,
        "minWidth": 480,
        "maxWidth": 480,
        "minHeight": 320,
        "maxHeight": 320,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "signCommand": "signtool sign /fd sha256 /tr http://timestamp.digicert.com /td sha256 /f \"../../electron/pfx/linkv.pfx\" /p \"0000\" \"%1\""
    },
    "targets": "all",
    "icon": [
      "../../electron/resources/firefox/icon.png",
      "../../electron/resources/firefox/icon.ico",
      "../../electron/resources/firefox/icon.icns"
    ]
  },
  "version": "1.0.9"
}
