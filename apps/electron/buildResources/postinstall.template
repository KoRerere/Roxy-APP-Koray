#!/bin/bash

# ============================================================================
# macOS PKG Postinstall 脚本模板
# ============================================================================
# 构建时会替换以下占位符：
#   {{REPORT_DOMAINS}} - 上报域名列表，用 | 分隔
#   {{REPORT_API_PATH}} - API 路径
#   {{APP_NAME}}       - 应用程序名称
# ============================================================================

# 环境配置（构建时替换）
REPORT_DOMAINS="{{REPORT_DOMAINS}}"
REPORT_API_PATH="{{REPORT_API_PATH}}"
APP_NAME="{{APP_NAME}}"

# ============================================================================
# 从安装包文件名中提取 UUID
# ============================================================================
# 文件名格式: RoxyBrowser_x64_6.5.9_2025_10_10-H-test__<UUID>.pkg
# UUID 位于最后两个下划线（__）之后，42位十六进制字符
extract_uuid_from_path() {
    local pkg_path="$1"
    local filename=$(basename "$pkg_path")

    if echo "$filename" | grep -q '__[a-f0-9]\{42\}'; then
        echo "$filename" | sed -n 's/.*__\([a-f0-9]\{42\}\).*/\1/p'
    else
        echo ""
    fi
}

# ============================================================================
# 遍历域名列表发送安装完成上报
# ============================================================================
# 采用多域名故障转移策略：依次尝试每个域名，任一成功即停止
send_report() {
    local uuid="$1"
    local domains="$2"
    local json_data="{\"uuid\":\"$uuid\",\"eventType\":\"install_complete\"}"

    # 分割域名列表（以 | 分隔）
    IFS='|' read -ra DOMAIN_ARRAY <<< "$domains"

    # 依次尝试每个域名
    for domain in "${DOMAIN_ARRAY[@]}"; do
        local api_url="${domain}${REPORT_API_PATH}"

        # 发送 POST 请求（6秒超时，静默处理）
        if curl -s -m 6 -X POST \
            -H "Content-Type: application/json" \
            -d "$json_data" \
            "$api_url" > /dev/null 2>&1; then
            return 0  # 成功即返回
        fi
    done

    return 1  # 所有域名都失败（静默处理，不影响安装）
}

# ============================================================================
# 主安装逻辑
# ============================================================================
main() {
    local installer_path="$1"
    local uuid=$(extract_uuid_from_path "$installer_path")

    # postinstall 由 macOS Installer 以 root 身份执行，
    # 这里通过 /dev/console 获取真正登录的用户，避免拿到 root
    local current_user
    current_user=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)
    [ -z "$current_user" ] || [ "$current_user" = "root" ] && current_user="$USER"

    # 解析该用户的 home 目录（不要用 $HOME，因为此刻 $HOME 是 /var/root）
    local user_home
    user_home=$(/usr/bin/dscl . -read "/Users/$current_user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
    [ -z "$user_home" ] && user_home=$(eval echo "~$current_user")

    # 应用数据目录
    local app_data_dir="$user_home/Library/Application Support/$APP_NAME"
    local installer_path_file="$app_data_dir/installer-path"

    # 创建目录并写入安装程序路径
    mkdir -p "$app_data_dir"
    echo "$installer_path" > "$installer_path_file"
    chmod 644 "$installer_path_file"
    chown -R "$current_user:staff" "$app_data_dir"

    # ============================================================================
    # 关键：把 /Applications/<APP_NAME>.app 的所有权交给登录用户
    # ----------------------------------------------------------------------------
    # PKG 默认由 root 写入 /Applications，导致 .app 归属 root:wheel。
    # 之后 electron-updater (Squirrel.Mac) 自更新时无法直接覆盖 .app，
    # 会通过 SMJobBless 请求安装特权 helper，弹出"添加帮助程序工具"授权窗。
    # 把 .app 的属主改为当前登录用户后，自更新就无需提权，弹窗消失。
    # ============================================================================
    local app_path="/Applications/${APP_NAME}.app"
    if [ -n "$current_user" ] && [ "$current_user" != "root" ] && [ -d "$app_path" ]; then
        chown -R "${current_user}:staff" "$app_path"
    fi

    # 异步发送安装上报（不阻塞安装流程）
    [ -n "$REPORT_DOMAINS" ] && send_report "$uuid" "$REPORT_DOMAINS" &

    exit 0
}

# 执行主函数
main "$@"

