{
  "mcpServers": {
    "roxybrowser-openapi": {
      "command": "node",
      "args": [
        "../roxybrowser-mcp-server/dist/index.mjs"
      ],
      "env": {
        "ROXY_API_KEY": "0a6ad41f086b7d5700c2cc9e937bd348",
