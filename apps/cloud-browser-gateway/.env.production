# 服务
PORT=3100
NODE_ENV=production

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Docker
DOCKER_SOCKET=/var/run/docker.sock
NEKO_IMAGE=buqiyuan/roxychrome145
NEKO_BROWSER_DATA_PATH=/home/neko/.config/RoxyChrome
# NEKO_BROWSER_BINARY_PATH=/opt/roxychrome/RoxyChrome
NEKO_AUDIO_BITRATE=128000
NEKO_VIDEO_BITRATE=1500000
# GPU/NVENC：开发环境默认 CPU，支持 GPU 时可改为 true + nvh264
NEKO_GPU_ENABLED=true
NEKO_VIDEO_ENCODER=nvh264

# 数据持久化
DATA_DIR=/data/cloud-browser

# 端口池
HTTP_PORT_RANGE_START=10000
HTTP_PORT_RANGE_END=10999
UDP_PORT_RANGE_START=50000
UDP_PORT_RANGE_END=50999

# WebRTC
WEBRTC_NAT1TO1=103.112.98.48
PUBLIC_BASE_URL=http://103.112.98.48

# 容器
CONTAINER_SHM_SIZE=4g
CONTAINER_CPU_LIMIT=8
CONTAINER_START_CPU_USAGE_LIMIT=85
CONTAINER_START_CPU_SAMPLE_INTERVAL_MS=500
CONTAINER_SCREEN=1600x900@30
CONTAINER_STOP_GRACE_PERIOD=20000

# 后端 API 基础地址
API_BASE_URL=https://apitest.roxybrowser.co

# 自定义前端页面
CUSTOM_FRONTEND_PAGE=/var/github/roxy-browser/apps/cloud-browser-user/dist
# 浏览器主题色（system / light / dark）
# BROWSER_COLOR_SCHEME=system
